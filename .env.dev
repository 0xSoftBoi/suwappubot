# ===========================================
# SUWAPPU BOT - AWS DEVELOPMENT ENVIRONMENT
# ===========================================
# This file documents what's configured in AWS for the dev environment.
# Secrets are stored in AWS Secrets Manager, NOT in this file.
#
# AWS Resources:
# - ECS Cluster: suwappu-cluster
# - ECS Service: suwappu-dev-service
# - Task Definition: suwappu-dev-task
# - Secrets: suwappu/dev-secrets, suwappu/app-secrets, suwappu/db-credentials

# =====================
# ENVIRONMENT
# =====================
ENVIRONMENT=development

# =====================
# SECRETS (from AWS Secrets Manager)
# =====================
# These are injected into ECS task from Secrets Manager:
#
# From suwappu/dev-secrets:
#   - TELEGRAM_BOT_TOKEN (dev bot: 8556505235:...)
#   - WEBAPP_URL (https://suwappu.dev)
#
# From suwappu/app-secrets:
#   - ENCRYPTION_KEY
#   - SECRET_KEY
#   - ADMIN_API_KEY
#   - LIFI_API_KEY
#   - ADMIN_IDS
#   - ALCHEMY_API_KEY
#
# From suwappu/db-credentials:
#   - DATABASE_URL (RDS PostgreSQL)

# =====================
# ENVIRONMENT VARIABLES (in task definition)
# =====================
PORT=10000
LOG_LEVEL=DEBUG
WALLET_PROVIDER=local

# =====================
# WEBAPP
# =====================
# Deployed to Vercel: https://suwappu.dev
# Set in suwappu/dev-secrets as WEBAPP_URL

# =====================
# TO UPDATE SECRETS
# =====================
# aws secretsmanager put-secret-value \
#   --secret-id suwappu/dev-secrets \
#   --secret-string '{"TELEGRAM_BOT_TOKEN":"...","WEBAPP_URL":"https://suwappu.dev"}' \
#   --profile Swappu

# =====================
# TO DEPLOY
# =====================
# Push to dev branch triggers GitHub Actions, or manually:
# aws ecs update-service --cluster suwappu-cluster --service suwappu-dev-service --force-new-deployment --profile Swappu
