# ETHGlobal Tokyo 2026 — fill in at the venue, never commit real values.
# Copy to .env (gitignored) before running the demo.

# --- World ID (developer.world.org) ---
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_ACTION=suwappu-trade-approval
WORLD_ENV=production
# Shown ONCE in the portal. Server-only. Never NEXT_PUBLIC_, never logged.
RP_SIGNING_KEY=
# AgentKit: EOA registered via `npx @worldcoin/agentkit-cli register`
AGENTKIT_AGENT_ADDRESS=

# --- Intercepta (Web3 Antivirus / W3A API) ---
INTERCEPTA_API_KEY=
# W3A base URL + endpoints verified against https://docs.web3antivirus.io (2026-09-25).
INTERCEPTA_BASE_URL=https://api.web3antivirus.io

# --- ENSv2 (Sepolia) ---
SEPOLIA_RPC_URL=
# Deployer/owner key for subname issuance. Testnet only.
ENSV2_OWNER_PRIVATE_KEY=
ENSV2_PARENT_NAME=suwappu
# Optional: pre-deployed PermissionedResolver proxy to reuse across agents
ENSV2_RESOLVER_ADDRESS=

# --- Uniswap (developers.uniswap.org/dashboard) ---
UNISWAP_API_KEY=
