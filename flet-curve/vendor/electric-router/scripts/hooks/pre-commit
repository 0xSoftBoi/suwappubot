#!/bin/sh
# Refuse to commit a lockfile that adopts something published this week.
#
# This is the gate, not CI: there is deliberately no CI here, and a lockfile can
# only enter the repository through a commit, so the commit is where the check
# belongs.  It runs only when a lockfile is actually staged, so it costs nothing
# on every other commit.
#
# Install (once, per clone):
#
#     ln -s ../../scripts/hooks/pre-commit .git/hooks/pre-commit
#
# A symlink rather than a copy, so edits to the hook take effect without
# reinstalling.  `core.hooksPath` would be tidier but would orphan the four
# git-lfs hooks this repository already has in `.git/hooks`.
#
# `git commit --no-verify` skips it, which is the right escape hatch for an
# urgent security release that has not aged yet -- deliberate, and visible in
# the reflog rather than silent.
set -e

staged=$(git diff --cached --name-only --diff-filter=ACM)
case "$staged" in
  *Cargo.lock*|*uv.lock*) ;;
  *) exit 0 ;;
esac

echo "  lockfile staged -- checking dependency ages"
if ! uv run python scripts/check_dependency_age.py; then
    echo
    echo "  Commit refused: a locked dependency is younger than the cooling-off"
    echo "  window.  Wait it out, or use 'git commit --no-verify' and say why in"
    echo "  the commit message."
    exit 1
fi
