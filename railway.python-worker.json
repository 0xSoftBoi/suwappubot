{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "api/Dockerfile.railway",
    "watchPatterns": [
      "/api/**",
      "/bot/**",
      "/database/**",
      "/requirements*.txt",
      "/pyproject.toml",
      "/uv.lock",
      "/railway.python-worker.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "limitOverride": {
      "containers": {
        "cpu": 2,
        "memoryBytes": 8589934592
      }
    },
    "multiRegionConfig": {
      "us-east4-eqdc4a": { "numReplicas": 1 }
    },
    "overlapSeconds": 0,
    "drainingSeconds": 30
  }
}
