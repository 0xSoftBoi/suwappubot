{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "showcase/Dockerfile",
    "watchPatterns": [
      "/showcase/**",
      "/packages/design-tokens/**",
      "/railway.showcase.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/robots.txt",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1
  }
}
