{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "api/Dockerfile.railway",
    "watchPatterns": ["scripts/uptime_probe.py", "scripts/status.py", "monitoring/**"]
  },
  "deploy": {
    "startCommand": "PROBE_SOURCE=railway-cron python3 scripts/uptime_probe.py --env prod",
    "cronSchedule": "*/10 * * * *",
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}
