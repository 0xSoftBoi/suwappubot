[Unit]
Description=Suwappu Telegram Bot
After=network.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/suwappubot
Environment=PATH=/home/ubuntu/suwappubot/venv/bin
EnvironmentFile=/home/ubuntu/suwappubot/.env
ExecStart=/home/ubuntu/suwappubot/venv/bin/python -m bot.main
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/suwappubot/data

[Install]
WantedBy=multi-user.target

