{
  "name": "@suwappu/sdk",
  "version": "0.6.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Official TypeScript SDK + CLI for Suwappu — cross-chain DEX quotes, swaps, portfolios, perps, prediction markets, and agent wallet controls.",
  "homepage": "https://suwappu.bot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xSoftBoi/suwappubot.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/0xSoftBoi/suwappubot/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "suwappu": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "test": "bun test src/__tests__"
  },
  "keywords": [
    "suwappu",
    "dex",
    "cross-chain",
    "swap",
    "defi",
    "sdk",
    "cli",
    "agent",
    "ai-agent",
    "telegram",
    "stablecoin",
    "solana",
    "evm",
    "perps",
    "hyperliquid",
    "polymarket",
    "morpho",
    "typescript"
  ],
  "author": "Suwappu",
  "license": "MIT",
  "dependencies": {
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^7.0.2"
  }
}
