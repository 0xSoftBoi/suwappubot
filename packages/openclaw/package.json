{
  "name": "@suwappu/openclaw",
  "version": "0.1.0",
  "publishConfig": { "access": "public" },
  "description": "OpenClaw — agent/MCP skill client for the Suwappu cross-chain DEX API (swaps, perps, predictions, lending)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "SKILL.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "suwappu",
    "openclaw",
    "agent",
    "mcp",
    "skill",
    "dex",
    "cross-chain",
    "swap",
    "defi"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0"
  }
