# Suwappu — example environment for local development.
#
#   cp .env.example .env
#
# Only the two variables in the REQUIRED block are mandatory. Everything below it has a
# working default, so a fresh checkout boots against SQLite with public RPC endpoints.
#
# NEVER commit your filled-in .env — it is gitignored for a reason.
# Full setting list and descriptions: bot/config/settings.py

# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Create a bot with @BotFather on Telegram and paste the token here.
TELEGRAM_BOT_TOKEN=

# 32-byte key used to encrypt wallet private keys at rest.
# Generate one with:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# ─── Core ────────────────────────────────────────────────────────────────────

# Defaults to a local SQLite file. For Postgres:
#   postgresql://user:password@localhost:5432/suwappu
DATABASE_URL=sqlite:///bot.db

LOG_LEVEL=INFO

# Polling (false) works for a single local instance. Webhooks are required if you
# ever run more than one replica, or you will process every update twice.
USE_WEBHOOK=false

# ─── Wallets and key management ──────────────────────────────────────────────

# 'local'   — keys encrypted in the database (fine for development)
# 'turnkey' — TEE-backed key management (production)
WALLET_PROVIDER=local

# 'dev'   — local mock, development only
# 'local' — env-var key-encryption key, set WALLET_MASTER_KEK below
# 'aws' / 'gcp' — cloud KMS, needs KMS_KEY_ID and KMS_REGION
KMS_PROVIDER=dev

# Required only when KMS_PROVIDER=local. Must differ from ENCRYPTION_KEY.
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
WALLET_MASTER_KEK=

# ─── RPC endpoints ───────────────────────────────────────────────────────────
# All have public defaults. Public endpoints are heavily rate-limited — supply your
# own (Alchemy, QuickNode, Helius) for anything beyond casual local testing.

ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
POLYGON_RPC_URL=
BSC_RPC_URL=
SOLANA_RPC_URL=

# Improves Solana reliability considerably over the public endpoint.
HELIUS_API_KEY=

# ─── Optional integrations ───────────────────────────────────────────────────

LIFI_API_KEY=

# Telegram user IDs with admin command access, comma-separated.
ADMIN_IDS=
