# Maintainer: Suwappu <support@suwappu.bot>
pkgname=suwappu-desktop-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Cross-chain DEX trading terminal"
arch=('x86_64')
url="https://suwappu.bot"
license=('MIT')
depends=('gtk3' 'webkit2gtk-4.1' 'xdg-utils' 'libsecret')
optdepends=('libnotify: desktop notifications')
provides=('suwappu-desktop')
conflicts=('suwappu-desktop')
options=('!strip' '!debug')
source=("${pkgname}-${pkgver}.AppImage::https://github.com/0xSoftBoi/suwappubot/releases/download/v${pkgver}/Suwappu-${pkgver}-x86_64.AppImage"
        "suwappu.desktop::https://raw.githubusercontent.com/0xSoftBoi/suwappubot/main/desktop/packaging/linux/suwappu.desktop")
sha256sums=('SKIP'
            'SKIP')
noextract=("${pkgname}-${pkgver}.AppImage")

package() {
    install -d "${pkgdir}/opt/suwappu"
    install -Dm755 "${srcdir}/${pkgname}-${pkgver}.AppImage" "${pkgdir}/opt/suwappu/suwappu.AppImage"

    # Desktop entry
    install -Dm644 "${srcdir}/suwappu.desktop" "${pkgdir}/usr/share/applications/suwappu.desktop"

    # Update Exec path in desktop entry
    sed -i 's|Exec=/opt/suwappu/suwappu|Exec=/opt/suwappu/suwappu.AppImage|' \
        "${pkgdir}/usr/share/applications/suwappu.desktop"

    # Launcher script
    install -d "${pkgdir}/usr/bin"
    cat > "${pkgdir}/usr/bin/suwappu" <<'EOF'
#!/bin/sh
exec /opt/suwappu/suwappu.AppImage "$@"
EOF
    chmod 755 "${pkgdir}/usr/bin/suwappu"

    # License
    install -Dm644 /dev/null "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
