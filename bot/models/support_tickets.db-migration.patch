 def _add_digest_columns(db_engine, inspector, is_sqlite: bool) -> None:
     """Add weekly_digest and last_digest_at columns to users table idempotently."""
@@ -474,6 +484,23 @@ def _add_digest_columns(db_engine, inspector, is_sqlite: bool) -> None:
             logger.info(f"Added users.{col_name}")
 
 
+def _add_support_ticket_kind_column(db_engine, inspector, is_sqlite: bool) -> None:
+    """Add the `kind` column to support_tickets for pre-bug-report deployments."""
+    cols = {c["name"] for c in inspector.get_columns("support_tickets")}
+    if "kind" in cols:
+        return
+    if is_sqlite:
+        ddl = "ALTER TABLE support_tickets ADD COLUMN kind VARCHAR(20) DEFAULT 'support'"
+    else:
+        ddl = (
+            "ALTER TABLE support_tickets ADD COLUMN IF NOT EXISTS "
+            "kind VARCHAR(20) DEFAULT 'support'"
+        )
+    with db_engine.begin() as conn:
+        conn.execute(text(ddl))
+    logger.info("Added support_tickets.kind")
+
+
