@@ -449,6 +449,16 @@ def _ensure_schema(db_engine) -> None:
     if "prediction_positions" in tables:
         _add_prediction_redeem_columns(db_engine, inspector, is_sqlite)
 
+    # --- support_tickets table (user support requests + bug reports) ---
+    if not inspector.has_table("support_tickets"):
