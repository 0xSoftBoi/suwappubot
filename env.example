# ===========================================
# SUWAPPU BOT - Environment Configuration
# ===========================================
# Rename this file to .env and fill in your values
# DO NOT commit .env to version control!

# =====================
# REQUIRED SETTINGS
# =====================

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Encryption Key for wallet private keys (32-byte hex string)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=your_64_character_hex_key_here

# =====================
# DATABASE
# =====================

# For SQLite (development):
DATABASE_URL=sqlite:///./suwappubot.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/suwappubot

# Database password for Docker
DB_PASSWORD=changeme_in_production

# =====================
# RPC ENDPOINTS
# =====================
# Use your own RPC endpoints for production (Alchemy, Infura, QuickNode)

ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
BSC_RPC_URL=https://bsc-dataseed1.binance.org
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
FANTOM_RPC_URL=https://rpc.ftm.tools
LINEA_RPC_URL=https://linea-mainnet.infura.io/v3/YOUR_KEY
MANTLE_RPC_URL=https://rpc.mantle.xyz
GNOSIS_RPC_URL=https://rpc.gnosischain.com
SCROLL_RPC_URL=https://rpc.scroll.io
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# =====================
# API KEYS (Optional)
# =====================

# Li.Fi API Key (optional, increases rate limits)
LIFI_API_KEY=

# CoinGecko API Key (optional, for higher limits)
COINGECKO_API_KEY=

# =====================
# ADMIN & FEES
# =====================

# Admin Telegram User IDs (comma-separated)
# Get your ID from @userinfobot
ADMIN_IDS=123456789

# Fee collector address (receives swap fees)
FEE_COLLECTOR_ADDRESS=0xYourAddressHere

# Default swap fee percentage
SWAP_FEE_PERCENTAGE=1.0

# =====================
# CACHING (Optional)
# =====================

# Redis URL for caching (improves performance)
REDIS_URL=redis://localhost:6379/0

# =====================
# LOGGING
# =====================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =====================
# TURNKEY WALLET INFRASTRUCTURE (Optional)
# =====================
# Use Turnkey for TEE-backed wallet security
# Get credentials from https://app.turnkey.com

# Wallet provider: "local" (encrypted in DB) or "turnkey" (TEE-backed)
WALLET_PROVIDER=local

# Turnkey Organization ID (from dashboard)
TURNKEY_ORGANIZATION_ID=

# Turnkey API Key (P-256 keypair)
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=

# Turnkey API Base URL
TURNKEY_BASE_URL=https://api.turnkey.com

# =====================
# OPTIONAL FEATURES
# =====================

# 2FA Secret Key Base (for generating TOTP secrets)
# TWO_FA_SECRET_BASE=your_secret_base

# Gas sponsorship wallet private key (for paymaster)
# GAS_SPONSOR_PRIVATE_KEY=

