name: Deploy Webapp to ECS

on:
  push:
    branches:
      - main
      - dev
    paths:
      - 'webapp/**'
      - '.github/workflows/deploy-webapp.yml'
  workflow_dispatch:
    inputs:
      environment:
        description: 'Environment to deploy'
        required: true
        default: 'production'
        type: choice
        options:
          - production
          - development

env:
  AWS_REGION: us-east-1
  ECR_REPOSITORY: suwappu-webapp
  ECS_CLUSTER: suwappu-cluster
  TURNKEY_ORG_ID: 5cf56ed5-5d6b-4290-8edb-f52670162aab
  TURNKEY_PROXY_URL: https://api.turnkey.com

permissions:
  id-token: write
  contents: read

jobs:
  deploy:
    name: Build and Deploy Webapp
    runs-on: ubuntu-latest
    environment: ${{ (github.ref == 'refs/heads/main' || inputs.environment == 'production') && 'production' || 'development' }}

    steps:
      - name: Checkout code
        uses: actions/checkout@v6

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v5
        with:
          role-to-assume: ${{ secrets.AWS_ROLE_ARN }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Login to Amazon ECR
        id: login-ecr
        uses: aws-actions/amazon-ecr-login@v2

      - name: Determine environment
        id: env
        run: |
          if [ "${{ github.event.inputs.environment }}" == "development" ] || [ "${{ github.ref }}" == "refs/heads/dev" ]; then
            echo "env=development" >> $GITHUB_OUTPUT
            echo "service=suwappu-webapp-dev" >> $GITHUB_OUTPUT
            echo "tag=development" >> $GITHUB_OUTPUT
            echo "api_url=https://devapi.suwappu.bot" >> $GITHUB_OUTPUT
            echo "url=https://devfront.suwappu.bot" >> $GITHUB_OUTPUT
            echo "rp_id=devfront.suwappu.bot" >> $GITHUB_OUTPUT
          else
            echo "env=production" >> $GITHUB_OUTPUT
            echo "service=suwappu-webapp-prod" >> $GITHUB_OUTPUT
            echo "tag=${{ github.sha }}" >> $GITHUB_OUTPUT
            echo "api_url=https://api.suwappu.bot" >> $GITHUB_OUTPUT
            echo "url=https://app.suwappu.bot" >> $GITHUB_OUTPUT
            echo "rp_id=app.suwappu.bot" >> $GITHUB_OUTPUT
          fi

      - name: Build, tag, and push image to Amazon ECR
        id: build-image
        env:
          ECR_REGISTRY: ${{ steps.login-ecr.outputs.registry }}
          IMAGE_TAG: ${{ steps.env.outputs.tag }}
          VITE_API_URL: ${{ steps.env.outputs.api_url }}
          VITE_TURNKEY_ORG_ID: ${{ env.TURNKEY_ORG_ID }}
          VITE_TURNKEY_RP_ID: ${{ steps.env.outputs.rp_id }}
          VITE_TURNKEY_PROXY_URL: ${{ env.TURNKEY_PROXY_URL }}
        run: |
          # Build from monorepo root so workspace deps (packages/shared) are available
          # --no-cache prevents stale build artifacts from Docker layer cache
          docker build \
            --no-cache \
            -f webapp/Dockerfile \
            --build-arg VITE_API_URL=$VITE_API_URL \
            --build-arg VITE_TURNKEY_ORG_ID=$VITE_TURNKEY_ORG_ID \
            --build-arg VITE_TURNKEY_RP_ID=$VITE_TURNKEY_RP_ID \
            --build-arg VITE_TURNKEY_PROXY_URL=$VITE_TURNKEY_PROXY_URL \
            --build-arg BUILD_TIMESTAMP=$(date -u +%Y%m%d%H%M%S) \
            --build-arg GIT_SHA=${{ github.sha }} \
            -t $ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG .

          # Also tag with SHA for traceability
          docker tag $ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG $ECR_REGISTRY/$ECR_REPOSITORY:${{ github.sha }}

          # Push both tags
          docker push $ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG
          docker push $ECR_REGISTRY/$ECR_REPOSITORY:${{ github.sha }}

          echo "image=$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG" >> $GITHUB_OUTPUT

      - name: Update ECS task definition with new image
        id: task-def
        env:
          ECR_REGISTRY: ${{ steps.login-ecr.outputs.registry }}
        run: |
          # Get current task definition from the service
          TASK_DEF_ARN=$(aws ecs describe-services \
            --cluster ${{ env.ECS_CLUSTER }} \
            --services ${{ steps.env.outputs.service }} \
            --query 'services[0].taskDefinition' --output text)

          # Get the full task definition and update the image
          NEW_IMAGE="${ECR_REGISTRY}/${{ env.ECR_REPOSITORY }}:${{ github.sha }}"
          echo "Updating task definition to image: $NEW_IMAGE"

          aws ecs describe-task-definition --task-definition "$TASK_DEF_ARN" \
            --query 'taskDefinition' | \
            jq --arg IMAGE "$NEW_IMAGE" \
            'del(.taskDefinitionArn, .revision, .status, .requiresAttributes, .compatibilities, .registeredAt, .registeredBy) |
             .containerDefinitions[0].image = $IMAGE' > /tmp/new-task-def.json

          # Register the new task definition
          NEW_TASK_DEF_ARN=$(aws ecs register-task-definition \
            --cli-input-json file:///tmp/new-task-def.json \
            --query 'taskDefinition.taskDefinitionArn' --output text)

          echo "Registered new task definition: $NEW_TASK_DEF_ARN"
          echo "task_def_arn=$NEW_TASK_DEF_ARN" >> $GITHUB_OUTPUT

      - name: Deploy to ECS
        run: |
          echo "Deploying to ${{ steps.env.outputs.env }} environment..."
          echo "Cluster: ${{ env.ECS_CLUSTER }}"
          echo "Service: ${{ steps.env.outputs.service }}"
          echo "Task Definition: ${{ steps.task-def.outputs.task_def_arn }}"

          aws ecs update-service \
            --cluster ${{ env.ECS_CLUSTER }} \
            --service ${{ steps.env.outputs.service }} \
            --task-definition ${{ steps.task-def.outputs.task_def_arn }} \
            --enable-execute-command \
            --force-new-deployment

          echo "Deployment initiated. Waiting for service to stabilize..."

      - name: Wait for deployment
        run: |
          aws ecs wait services-stable \
            --cluster ${{ env.ECS_CLUSTER }} \
            --services ${{ steps.env.outputs.service }}

          echo "Deployment complete!"

      - name: Health check
        run: |
          echo "Checking webapp..."
          sleep 10
          curl -sf "${{ steps.env.outputs.url }}" || echo "Health check pending (service may still be starting)"

      - name: Deployment summary
        run: |
          echo "## Webapp Deployment Summary" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "| Property | Value |" >> $GITHUB_STEP_SUMMARY
          echo "|----------|-------|" >> $GITHUB_STEP_SUMMARY
          echo "| Environment | ${{ steps.env.outputs.env }} |" >> $GITHUB_STEP_SUMMARY
          echo "| Image | \`${{ steps.build-image.outputs.image }}\` |" >> $GITHUB_STEP_SUMMARY
          echo "| ECS Cluster | ${{ env.ECS_CLUSTER }} |" >> $GITHUB_STEP_SUMMARY
          echo "| ECS Service | ${{ steps.env.outputs.service }} |" >> $GITHUB_STEP_SUMMARY
          echo "| URL | ${{ steps.env.outputs.url }} |" >> $GITHUB_STEP_SUMMARY
          echo "| Commit | ${{ github.sha }} |" >> $GITHUB_STEP_SUMMARY
