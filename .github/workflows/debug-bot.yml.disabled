name: Debug Bot Status

on:
  workflow_dispatch:

env:
  AWS_REGION: us-east-1
  ECS_CLUSTER: suwappu-cluster

permissions:
  id-token: write
  contents: read

jobs:
  debug:
    name: Check Bot Status
    runs-on: ubuntu-latest

    steps:
      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v5
        with:
          role-to-assume: ${{ secrets.AWS_ROLE_ARN }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Check ECS service status
        run: |
          echo "=== Service Status ==="
          aws ecs describe-services \
            --cluster ${{ env.ECS_CLUSTER }} \
            --services suwappu-bot-prod \
            --query 'services[0].{status:status,desiredCount:desiredCount,runningCount:runningCount,taskDefinition:taskDefinition,deployments:deployments}' \
            --output json

      - name: List recent tasks
        run: |
          echo "=== Recent Tasks ==="
          TASK_ARNS=$(aws ecs list-tasks \
            --cluster ${{ env.ECS_CLUSTER }} \
            --service-name suwappu-bot-prod \
            --query 'taskArns' \
            --output json)
          echo "$TASK_ARNS"

          if [ "$TASK_ARNS" != "[]" ]; then
            aws ecs describe-tasks \
              --cluster ${{ env.ECS_CLUSTER }} \
              --tasks $(echo "$TASK_ARNS" | python3 -c "import sys,json; print(' '.join(json.load(sys.stdin)))") \
              --query 'tasks[*].{taskArn:taskArn,lastStatus:lastStatus,stoppedReason:stoppedReason,containers:containers[*].{name:name,lastStatus:lastStatus,exitCode:exitCode,reason:reason}}' \
              --output json
          fi

      - name: Get task definition details
        run: |
          echo "=== Task Definition ==="
          TASK_DEF=$(aws ecs describe-services \
            --cluster ${{ env.ECS_CLUSTER }} \
            --services suwappu-bot-prod \
            --query 'services[0].taskDefinition' \
            --output text)

          aws ecs describe-task-definition \
            --task-definition "$TASK_DEF" \
            --query 'taskDefinition.containerDefinitions[*].{name:name,image:image,logConfiguration:logConfiguration}' \
            --output json

      - name: Check CloudWatch logs
        run: |
          echo "=== Recent Bot Logs ==="
          # List log streams to find the active one
          echo "--- Log streams in /ecs/suwappu-bot ---"
          aws logs describe-log-streams \
            --log-group-name /ecs/suwappu-bot \
            --order-by LastEventTime \
            --descending \
            --limit 5 \
            --query 'logStreams[*].{name:logStreamName,lastEvent:lastEventTimestamp}' \
            --output json 2>&1 || echo "Could not list log streams"

          echo ""
          echo "--- Latest logs ---"
          aws logs get-log-events \
            --log-group-name /ecs/suwappu-bot \
            --log-stream-name "$(aws logs describe-log-streams --log-group-name /ecs/suwappu-bot --order-by LastEventTime --descending --limit 1 --query 'logStreams[0].logStreamName' --output text 2>/dev/null)" \
            --limit 50 \
            --query 'events[*].message' \
            --output json 2>&1 | python3 -c "import sys,json; [print(m) for m in json.load(sys.stdin)]" 2>&1 || echo "Could not read logs"

      - name: Get bot token and test Telegram API
        run: |
          echo "=== Extracting bot token from task definition ==="
          TASK_DEF=$(aws ecs describe-services \
            --cluster ${{ env.ECS_CLUSTER }} \
            --services suwappu-bot-prod \
            --query 'services[0].taskDefinition' \
            --output text)

          # Get all env vars and secrets references
          echo "--- Environment variables ---"
          aws ecs describe-task-definition \
            --task-definition "$TASK_DEF" \
            --query 'taskDefinition.containerDefinitions[0].environment' \
            --output json 2>&1

          echo ""
          echo "--- Secrets references ---"
          aws ecs describe-task-definition \
            --task-definition "$TASK_DEF" \
            --query 'taskDefinition.containerDefinitions[0].secrets' \
            --output json 2>&1

          # Try to get the actual token from Secrets Manager
          echo ""
          echo "--- Attempting to read secrets ---"
          # List available secrets
          aws secretsmanager list-secrets --query 'SecretList[*].Name' --output json 2>&1 || echo "Cannot list secrets"

          # Get token from Secrets Manager
          RESULT=$(aws secretsmanager get-secret-value --secret-id "suwappu/app-secrets" --query 'SecretString' --output text 2>&1)
          TOKEN=$(echo "$RESULT" | python3 -c "import sys,json; print(json.load(sys.stdin).get('TELEGRAM_BOT_TOKEN','NOT_FOUND'))")
          echo "Found token: ${TOKEN:0:10}..."

          echo ""
          echo "=== Telegram getMe ==="
          curl -sf "https://api.telegram.org/bot${TOKEN}/getMe"

          echo ""
          echo "=== Telegram getWebhookInfo ==="
          curl -sf "https://api.telegram.org/bot${TOKEN}/getWebhookInfo"

          echo ""
          echo "=== Pending updates ==="
          curl -sf "https://api.telegram.org/bot${TOKEN}/getUpdates?limit=5&timeout=1" | python3 -c "
import sys,json
data = json.load(sys.stdin)
print(f'ok: {data.get(\"ok\")}')
results = data.get('result',[])
print(f'updates: {len(results)}')
for u in results[:5]:
    msg = u.get('message') or u.get('callback_query',{}).get('message',{})
    text = u.get('message',{}).get('text') or u.get('callback_query',{}).get('data','?')
    who = (u.get('message') or u.get('callback_query',{})).get('from',{}).get('username','?')
    print(f'  [{u.get(\"update_id\")}] {text} from {who}')
" 2>&1 || echo "Could not parse updates"

      - name: Check container logs via ECS stopped tasks
        continue-on-error: true
        run: |
          echo "=== Recently stopped tasks ==="
          STOPPED=$(aws ecs list-tasks \
            --cluster ${{ env.ECS_CLUSTER }} \
            --service-name suwappu-bot-prod \
            --desired-status STOPPED \
            --query 'taskArns' \
            --output json 2>/dev/null)
          echo "$STOPPED"

          echo ""
          echo "=== Full running task details ==="
          TASK_ARN=$(aws ecs list-tasks \
            --cluster ${{ env.ECS_CLUSTER }} \
            --service-name suwappu-bot-prod \
            --query 'taskArns[0]' \
            --output text)

          aws ecs describe-tasks \
            --cluster ${{ env.ECS_CLUSTER }} \
            --tasks "$TASK_ARN" \
            --query 'tasks[0].{lastStatus:lastStatus,healthStatus:healthStatus,startedAt:startedAt,containers:containers[*].{name:name,lastStatus:lastStatus,healthStatus:healthStatus,reason:reason}}' \
            --output json
