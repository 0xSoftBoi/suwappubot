# Self-contained image for the Python monolith (FastAPI + Telegram bot + background
# services) — for Railway. Unlike api/Dockerfile (which layers a few files onto the
# private ECR base image 905418423235.dkr.ecr.us-east-1.amazonaws.com/suwappu:latest),
# this builds everything from a public base + requirements.txt, so it has no AWS dependency.
#
# Build context MUST be the repo root (needs api/, bot/, database/, requirements.txt).
# On Railway: set the service Root Directory to the repo root and Dockerfile Path to
# api/Dockerfile.railway.
#
# Python 3.12 is pinned: all dependency pins in requirements.txt ship cp312/abi3 manylinux
# wheels for the C/Rust extensions (solders, pydantic_core, ckzg, cryptography,
# psycopg2-binary, Pillow).

# ---- Builder: install deps into an isolated venv (with build tools as a fallback for
#      any package that ships only an sdist) ----
FROM python:3.12-slim-bookworm AS builder
# NOTE: 3.12 — the codebase uses PEP 604 `X | None` annotations that evaluate at
# import time, which require Python >= 3.10. The pinned deps in requirements.txt all ship
# 3.12 manylinux wheels.
# DO NOT bump to 3.13/3.14: coincurve==21.0.0 (and other pins) have no cp313/cp314
# wheels yet — pip resolution fails and every python-api build dies on Railway.
# Dependabot's docker ecosystem keeps proposing this; ignored in .github/dependabot.yml.

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        libpq-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt

# ---- Runtime: slim image, no build tools, non-root ----
FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH"

# libpq5 is the runtime lib for psycopg2 (psycopg2-binary bundles it, but keep it for the
# source-built fallback). curl is for the healthcheck.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1000 botuser

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY --chown=botuser:botuser api/ /app/api/
COPY --chown=botuser:botuser bot/ /app/bot/
COPY --chown=botuser:botuser database/ /app/database/

# Writable dir for the Telegram bot's PicklePersistence (api/main.py writes data/bot_persistence.pickle).
# /app is root-owned, so the non-root botuser needs this pre-created and owned.
# /app itself is created by WORKDIR as root, so botuser cannot mkdir inside it.
# aegis-shield's telemetry writes to a CWD-relative `.aegis/` and creates the
# directory on first scan — which raised PermissionError on every single scan,
# and because AEGIS is fail-open that silently disabled injection scanning in
# production. Pre-create it owned by botuser. Contents are disposable (the
# service mirrors detections to app logs precisely because this does not
# survive a redeploy); it only has to be writable.
RUN mkdir -p /app/data /app/.aegis && chown botuser:botuser /app/data /app/.aegis

USER botuser

EXPOSE 8000

# Railway injects $PORT; fall back to 8000 for local/other platforms. Shell form so $PORT
# expands at runtime; exec so uvicorn is PID 1 and receives SIGTERM for graceful drain.
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -fsS "http://localhost:${PORT:-8000}/health" || exit 1

# --proxy-headers (uvicorn's default is actually already True, but made explicit here)
# tells uvicorn to trust X-Forwarded-For/-Proto from the immediate TCP peer named in
# --forwarded-allow-ips. Without this, uvicorn's default forwarded-allow-ips=127.0.0.1
# never matches Railway's edge (which connects from its own infra IP, not localhost), so
# every request's "peer" collapses to that one edge IP for every deployment — this is what
# made api/routes/mobile.py's per-IP pairing-code cap a GLOBAL cap instead of per-client
# (see bot/services/mobile_pairing_service.py::_MAX_PENDING_PER_IP).
#
# forwarded-allow-ips="*" (trust the header from ANY immediate peer) is used, not a fixed
# CIDR, because Railway does not publish a stable/enumerable IP range for its edge — and
# because Railway's public domain is the ONLY way to reach this container (there is no
# route for an internet client to open a TCP connection to it directly; private-networking
# calls use *.railway.internal and don't traverse the public edge at all). So the immediate
# TCP peer for every request that reaches this process over the public domain is always
# Railway's own edge, making "*" here equivalent in practice to naming that one trusted hop
# — it does not let an arbitrary internet client spoof its own peer identity, since they
# can't connect directly to begin with. If Railway ever exposes containers to raw public
# traffic (bypassing the edge) this assumption breaks and needs revisiting.
#
# api/routes/mobile.py::_client_ip additionally parses X-Forwarded-For itself (rightmost
# hop only) as defense in depth, independent of this flag.
CMD exec uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips="*"

