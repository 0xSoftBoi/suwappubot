# Suwappu — Base Sepolia testnet contract wiring
# Source this for local testing, or set these in Railway (dev environment).
# These are PUBLIC contract addresses — safe to commit. No secrets here.

# ─── Deployed contracts (Base Sepolia, chain 84532) ─────────────────────────
SUWP_CONTRACT_ADDRESS=0x0b96a41a2a4c9b50097049d24f43848be3A892e8
STAKING_CONTRACT_ADDRESS=0xFA1142C788b6BC09CD16490dFEdAcEAFC505bA17
BONDS_CONTRACT_ADDRESS=0x9aCCf607AF27327B4940827a5c389F109847562D

# Superfluid GDA streaming pool (read by GET /staking/streaming-balance)
STAKING_POOL_ADDRESS=0x924c4FA120d647B432D1E9F6e9632c2f4CEDfCFf

# Super token + underlying (USDCx wraps the Circle test USDC)
USDCX_ADDRESS=0xC821107bE6E8eD189F3fe05AD06C496243b53B55
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Uniswap v3 SUWP/USDC pool for bonds — not created on testnet yet
SUWP_USDC_POOL_ADDRESS=

# RPC for the API's on-chain reads (use your own Alchemy/QuickNode key in prod)
BASE_RPC_URL=https://sepolia.base.org

# Vault stays in mock mode on testnet (no Aave position)
AAVE_ENABLED=false
VAULT_TYPE=aave
