requests==2.34.2
aiohttp==3.14.1
websockets==15.0.1
# certifi is transitive, but pinned deliberately for the aiohttp SSL health-check
# fix (commit 32d0805) — keep a floor so pip-compile can't resolve below it.
certifi>=2026.6.17
