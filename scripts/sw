#!/usr/bin/env bash
set -euo pipefail

# sw -- Git worktree manager for Suwappu parallel development.
# Usage: sw <command> [args]
#
# Commands:
#   new <name> [claude]       Create a worktree and optionally open Claude Code in it
#   ls                        List active worktrees
#   cd <name>                 Print the path to a worktree (use with: cd $(sw cd <name>))
#   rm <name>                 Remove a worktree and clean up
#   clean                     Remove worktrees whose branches have been merged into main
#   parallel <name> [name..] Launch tmux session with Claude Code in each worktree
#   help                      Show this help

MAIN_REPO="$HOME/Desktop/suwappumain/suwappubot"
WORKTREE_BASE="$HOME/Desktop/suwappumain/worktrees"
BOOTSTRAP_SCRIPT="$MAIN_REPO/scripts/worktree-setup.sh"

_usage() {
  cat <<'HELP'
sw -- Git worktree manager for Suwappu

Commands:
  sw new <name> [claude]        Create a worktree. Add "claude" to launch Claude Code in it.
  sw ls                         List active worktrees
  sw cd <name>                  Print worktree path (use: cd "$(sw cd <name>)")
  sw rm <name>                  Remove a worktree and optionally delete the branch
  sw clean                      Remove worktrees whose branches have been merged into main
  sw parallel <name> [name..]   Launch tmux session with Claude Code in each worktree
  sw help                       Show this help
HELP
}

_new() {
  local name="${1:?Usage: sw new <name> [claude]}"
  local open_claude="${2:-}"
  local wt_path="$WORKTREE_BASE/$name"

  if [[ -d "$wt_path" ]]; then
    echo "Worktree '$name' already exists at $wt_path"
    exit 1
  fi

  mkdir -p "$WORKTREE_BASE"

  # Create worktree: reuse existing branch or create new one
  if git -C "$MAIN_REPO" show-ref --verify --quiet "refs/heads/$name" 2>/dev/null; then
    echo "==> Using existing branch '$name'"
    git -C "$MAIN_REPO" worktree add "$wt_path" "$name"
  else
    echo "==> Creating new branch '$name' from HEAD"
    git -C "$MAIN_REPO" worktree add "$wt_path" -b "$name"
  fi

  # Bootstrap dependencies
  if [[ -x "$BOOTSTRAP_SCRIPT" ]]; then
    bash "$BOOTSTRAP_SCRIPT" "$wt_path"
  elif [[ -f "$BOOTSTRAP_SCRIPT" ]]; then
    bash "$BOOTSTRAP_SCRIPT" "$wt_path"
  else
    echo "    (bootstrap script not found at $BOOTSTRAP_SCRIPT -- skipping)"
  fi

  # Create .ai-context.md template for task-specific context
  if [[ ! -f "$wt_path/.ai-context.md" ]]; then
    cat > "$wt_path/.ai-context.md" <<AICTX
# Task: $name

## Goal
<!-- What should this worktree accomplish? -->

## Key Files
<!-- Which files will be modified? -->

## Constraints
<!-- Any rules or boundaries? -->

## Success Criteria
<!-- How do you know it's done? -->
AICTX
    echo "    Created .ai-context.md template"
  fi

  echo ""
  echo "Worktree ready: $wt_path"
  echo "  cd $wt_path"

  # Optionally open Claude Code
  if [[ "$open_claude" == "claude" ]]; then
    echo "==> Launching Claude Code..."
    (cd "$wt_path" && claude) &
    disown
    echo "Claude Code launched in background for $wt_path"
  fi
}

_ls() {
  git -C "$MAIN_REPO" worktree list
}

_cd() {
  local name="${1:?Usage: sw cd <name>}"
  local wt_path="$WORKTREE_BASE/$name"

  if [[ ! -d "$wt_path" ]]; then
    echo "Error: No worktree '$name' found at $wt_path" >&2
    exit 1
  fi

  # Print path so caller can use: cd "$(sw cd <name>)"
  echo "$wt_path"
}

_rm() {
  local name="${1:?Usage: sw rm <name>}"
  local wt_path="$WORKTREE_BASE/$name"

  if [[ ! -d "$wt_path" ]]; then
    echo "Error: No worktree '$name' found at $wt_path" >&2
    exit 1
  fi

  echo "==> Removing worktree: $wt_path"
  git -C "$MAIN_REPO" worktree remove "$wt_path" --force

  # Ask about branch deletion
  if git -C "$MAIN_REPO" show-ref --verify --quiet "refs/heads/$name" 2>/dev/null; then
    read -r -p "Delete branch '$name'? [y/N] " answer
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      git -C "$MAIN_REPO" branch -d "$name" 2>/dev/null || \
        git -C "$MAIN_REPO" branch -D "$name"
      echo "Branch '$name' deleted."
    else
      echo "Branch '$name' kept."
    fi
  fi

  git -C "$MAIN_REPO" worktree prune
  echo "Done."
}

_clean() {
  echo "==> Checking for worktrees with merged branches..."

  # Get branches merged into main
  local merged
  merged=$(git -C "$MAIN_REPO" branch --merged main --no-color | sed 's/^[* ]*//' | grep -v '^main$' || true)

  if [[ -z "$merged" ]]; then
    echo "No merged branches found. Nothing to clean."
    return
  fi

  local cleaned=0

  # Check each worktree
  while IFS= read -r line; do
    local wt_path branch
    wt_path=$(echo "$line" | awk '{print $1}')
    branch=$(echo "$line" | sed -n 's/.*\[//;s/\].*//p')

    # Skip main repo and bare entries
    [[ "$wt_path" == "$MAIN_REPO" ]] && continue
    [[ -z "$branch" ]] && continue

    # Check if this branch is in the merged list
    if echo "$merged" | grep -qx "$branch"; then
      read -r -p "Remove worktree '$branch' at $wt_path? (branch merged into main) [y/N] " answer
      if [[ "$answer" =~ ^[Yy]$ ]]; then
        git -C "$MAIN_REPO" worktree remove "$wt_path" --force
        git -C "$MAIN_REPO" branch -d "$branch" 2>/dev/null || true
        echo "  Removed worktree and branch '$branch'."
        cleaned=$((cleaned + 1))
      else
        echo "  Skipped '$branch'."
      fi
    fi
  done < <(git -C "$MAIN_REPO" worktree list)

  git -C "$MAIN_REPO" worktree prune
  echo "Done. Cleaned $cleaned worktree(s)."
}

_parallel() {
  if [[ $# -eq 0 ]]; then
    echo "Usage: sw parallel <name> [name...]" >&2
    echo "Launch tmux session with Claude Code in each worktree." >&2
    exit 1
  fi

  # Check for tmux
  if ! command -v tmux &>/dev/null; then
    echo "Error: tmux is required for 'sw parallel'." >&2
    echo "Install with: brew install tmux" >&2
    exit 1
  fi

  local session="sw"
  local first=true

  # Kill existing session if present
  if tmux has-session -t "$session" 2>/dev/null; then
    read -r -p "Tmux session '$session' already exists. Kill it? [y/N] " answer
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      tmux kill-session -t "$session"
    else
      echo "Aborted."
      exit 1
    fi
  fi

  for name in "$@"; do
    local wt_path="$WORKTREE_BASE/$name"

    # Create worktree if it doesn't exist
    if [[ ! -d "$wt_path" ]]; then
      echo "==> Creating worktree '$name'..."
      _new "$name"
    fi

    if $first; then
      # Create new tmux session with first worktree
      tmux new-session -d -s "$session" -n "$name" -c "$wt_path"
      tmux send-keys -t "$session:$name" "claude" Enter
      first=false
    else
      # Add window for each subsequent worktree
      tmux new-window -t "$session" -n "$name" -c "$wt_path"
      tmux send-keys -t "$session:$name" "claude" Enter
    fi
  done

  echo "==> Attaching to tmux session '$session' with $# worktree(s)..."
  tmux attach-session -t "$session"
}

# ── Main dispatch ────────────────────────────────────────────────────
cmd="${1:-help}"
shift || true

case "$cmd" in
  new)      _new "$@" ;;
  ls)       _ls ;;
  cd)       _cd "$@" ;;
  rm)       _rm "$@" ;;
  clean)    _clean ;;
  parallel) _parallel "$@" ;;
  help)     _usage ;;
  *)
    echo "Unknown command: $cmd" >&2
    _usage
    exit 1
    ;;
esac
