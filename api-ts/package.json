    "drizzle-orm": "^0.45.1",
    "effect": "^3.10.0",
    "esbuild": "^0.27.2",
    "hono": "^4.6.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
