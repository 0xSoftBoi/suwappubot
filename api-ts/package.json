    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@effect/schema": "^0.75.5",
    "drizzle-orm": "^0.35.0",
    "effect": "^3.10.0",
    "hono": "^4.6.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.14",
    "drizzle-kit": "^0.27.0",
    "typescript": "^5.6.3"
  }
}
