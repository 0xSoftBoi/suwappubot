{
  "family": "suwappu-api-ts-dev",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/SuwappuStack-SuwappuTaskExecutionRole23EC76C6-U9AyrZNZlcfs",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/SuwappuStack-SuwappuTaskTaskRoleB8E1A138-WPL93Pi0RLpk",
  "containerDefinitions": [
    {
      "name": "api-ts",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/suwappu-api-ts:development",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "development"
        },
        {
          "name": "PORT",
          "value": "8000"
        },
        {
          "name": "ALLOWED_ORIGINS",
          "value": "https://devfront.suwappu.bot,https://app.suwappu.bot,http://localhost:3000,http://localhost:5173"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:${AWS_ACCOUNT_ID}:secret:suwappu/app-secrets-DjSwC3:DATABASE_URL::"
        },
        {
          "name": "TELEGRAM_BOT_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:${AWS_ACCOUNT_ID}:secret:suwappu/app-secrets-DjSwC3:TELEGRAM_BOT_TOKEN::"
        },
        {
          "name": "AGENT_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:${AWS_ACCOUNT_ID}:secret:suwappu/db-credentials-mAlclG:AGENT_API_KEY::"
        },
        {
          "name": "ALCHEMY_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:${AWS_ACCOUNT_ID}:secret:suwappu/app-secrets-DjSwC3:ALCHEMY_API_KEY::"
        },
        {
          "name": "LIFI_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:${AWS_ACCOUNT_ID}:secret:suwappu/app-secrets-DjSwC3:LIFI_API_KEY::"
        },
        {
          "name": "WHATSAPP_ACCESS_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:${AWS_ACCOUNT_ID}:secret:suwappu/app-secrets-DjSwC3:WHATSAPP_ACCESS_TOKEN::"
        },
        {
          "name": "ADMIN_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:${AWS_ACCOUNT_ID}:secret:suwappu/app-secrets-DjSwC3:ADMIN_API_KEY::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/suwappu",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "api-ts-dev"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "bun -e \"fetch('http://localhost:8000/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}