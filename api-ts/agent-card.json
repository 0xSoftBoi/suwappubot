{
  "$schema": "https://specs.a2aprotocol.ai/agent-card.json",
  "id": "suwappu-dex",
  "name": "Suwappu",
  "description": "Cross-chain DEX for AI agents. Swap tokens across 18 chains via natural language.",
  "version": "0.5.0",
  "url": "https://api.suwappu.bot",
  "logo": "https://suwappu.bot/logo.png",
  "openApiUrl": "https://api.suwappu.bot/v1/agent/openapi",
  "protocolVersions": [
    "0.3"
  ],
  "interfaces": [
    {
      "type": "JSON-RPC",
      "baseUrl": "https://api.suwappu.bot/a2a",
      "version": "1.0"
    }
  ],
  "securitySchemes": {
    "bearer": {
      "type": "http",
      "scheme": "bearer",
      "description": "Register at POST /v1/agent/register to get an API key (suwappu_sk_...)"
    }
  },
  "capabilities": {
    "streaming": false,
    "pushNotifications": true,
    "stateTransitionHistory": false,
    "extensions": [
      {
        "uri": "https://github.com/google-agentic-commerce/a2a-x402",
        "description": "x402 pay-per-call support: paid tools/endpoints may return an HTTP 402 payment challenge (x402 protocol, USDC on Base) instead of failing on insufficient prepaid credit balance.",
        "required": false
      }
    ]
  },
  "authentication": {
    "schemes": [
      "bearer"
    ],
    "credentials": null
  },
  "defaultInputModes": [
    "text"
  ],
  "defaultOutputModes": [
    "text"
  ],
  "skills": [
    {
      "id": "swap",
      "name": "Token Swap",
      "description": "Swap tokens across 18 chains (15 EVM + Solana + Sui + TON)",
      "tags": [
        "defi",
        "swap",
        "trading",
        "cross-chain"
      ],
      "examples": [
        "swap 0.5 ETH to USDC on Base",
        "swap 100 USDC to SOL on Solana",
        "bridge 500 USDC from Ethereum to Arbitrum"
      ],
      "inputModes": [
        "text"
      ],
      "outputModes": [
        "text"
      ],
      "operationId": "executeSwap",
      "x-endpoint": "POST /v1/agent/swap"
    },
    {
      "id": "quote",
      "name": "Get Quote",
      "description": "Get a swap quote without executing",
      "tags": [
        "defi",
        "quote",
        "price"
      ],
      "examples": [
        "quote 1 ETH to USDC",
        "price of 100 USDC in ETH"
      ],
      "inputModes": [
        "text"
      ],
      "outputModes": [
        "text"
      ],
      "operationId": "getQuote",
      "x-endpoint": "POST /v1/agent/quote"
    },
    {
      "id": "portfolio",
      "name": "Portfolio Check",
      "description": "Check token balances across all chains",
      "tags": [
        "balance",
        "portfolio",
        "wallet"
      ],
      "examples": [
        "check balance",
        "show portfolio"
      ],
      "inputModes": [
        "text"
      ],
      "outputModes": [
        "text"
      ],
      "operationId": "getPortfolio",
      "x-endpoint": "GET /v1/agent/portfolio"
    },
    {
      "id": "prices",
      "name": "Token Prices",
      "description": "Get real-time token prices with 24h change",
      "tags": [
        "defi",
        "price",
        "market-data"
      ],
      "examples": [
        "get ETH price",
        "check SOL and USDC prices"
      ],
      "inputModes": [
        "text"
      ],
      "outputModes": [
        "text"
      ],
      "operationId": "getPrices",
      "x-endpoint": "GET /v1/agent/prices"
    },
    {
      "id": "tokens",
      "name": "Token Discovery",
      "description": "List available tokens per chain for quoting and swapping",
      "tags": [
        "defi",
        "tokens",
        "discovery"
      ],
      "examples": [
        "list tokens on Base",
        "search for USD tokens"
      ],
      "inputModes": [
        "text"
      ],
      "outputModes": [
        "text"
      ],
      "operationId": "listTokens",
      "x-endpoint": "GET /v1/agent/tokens"
    },
    {
      "id": "key-management",
      "name": "API Key Management",
      "description": "Rotate API keys for security",
      "tags": [
        "security",
        "keys"
      ],
      "examples": [
        "rotate my API key"
      ],
      "inputModes": [
        "text"
      ],
      "outputModes": [
        "text"
      ],
      "operationId": "rotateApiKey",
      "x-endpoint": "POST /v1/agent/rotate-key"
    },
    {
      "id": "webhook-management",
      "name": "Webhook Management",
      "description": "List webhook delivery events and test webhook endpoints",
      "tags": [
        "webhooks",
        "notifications"
      ],
      "examples": [
        "list webhook events",
        "test my webhook"
      ],
      "inputModes": [
        "text"
      ],
      "outputModes": [
        "text"
      ],
      "operationId": "testWebhook",
      "x-endpoint": "POST /v1/agent/webhooks/test"
    },
    {
      "id": "swap-status",
      "name": "Swap Status",
      "description": "Get the status of a previously executed swap by ID",
      "tags": [
        "defi",
        "swap",
        "status"
      ],
      "examples": [
        "check status of swap 123",
        "did my swap complete?"
      ],
      "inputModes": [
        "text"
      ],
      "outputModes": [
        "text"
      ],
      "operationId": "getSwapStatus",
      "x-endpoint": "GET /v1/agent/swap/status/{swapId}"
    },
    {
      "id": "swap-history",
      "name": "Swap History",
      "description": "List paginated swap history for the authenticated agent",
      "tags": [
        "defi",
        "swap",
        "history"
      ],
      "examples": [
        "list my recent swaps",
        "show completed swaps"
      ],
      "inputModes": [
        "text"
      ],
      "outputModes": [
        "text"
      ],
      "operationId": "listSwaps",
      "x-endpoint": "GET /v1/agent/swaps"
    },
    {
      "id": "wallets",
      "name": "Wallet Management",
      "description": "List and create managed (Turnkey-custodied) agent wallets",
      "tags": [
        "wallet",
        "custody"
      ],
      "examples": [
        "list my wallets",
        "create a new wallet"
      ],
      "inputModes": [
        "text"
      ],
      "outputModes": [
        "text"
      ],
      "operationId": "listWallets",
      "x-endpoint": "GET /v1/agent/wallets",
      "x-write-endpoint": "POST /v1/agent/wallets"
    },
    {
      "id": "wallet-policies",
      "name": "Wallet Policies",
      "description": "List Turnkey spending/whitelist policies configured on the agent's managed wallet",
      "tags": [
        "wallet",
        "security",
        "policy"
      ],
      "examples": [
        "show my wallet policies",
        "what spending limits are set on my wallet?"
      ],
      "inputModes": [
        "text"
      ],
      "outputModes": [
        "text"
      ],
      "operationId": "getWalletPolicies",
      "x-endpoint": "GET /v1/agent/wallet/policies"
    },
    {
      "id": "billing",
      "name": "Billing & Credits",
      "description": "Get the authenticated agent's credit balance, subscription tier, and cost-per-call weights",
      "tags": [
        "billing",
        "credits",
        "subscription"
      ],
      "examples": [
        "check my credit balance",
        "what's my subscription tier?"
      ],
      "inputModes": [
        "text"
      ],
      "outputModes": [
        "text"
      ],
      "operationId": "getBilling",
      "x-endpoint": "GET /v1/agent/billing"
    }
  ],
  "provider": {
    "organization": "Suwappu",
    "url": "https://suwappu.bot"
  },
  "supportedChains": [
    {
      "id": 1,
      "name": "Ethereum",
      "native": "ETH"
    },
    {
      "id": 10,
      "name": "Optimism",
      "native": "ETH"
    },
    {
      "id": 56,
      "name": "BNB Chain",
      "native": "BNB"
    },
    {
      "id": 137,
      "name": "Polygon",
      "native": "MATIC"
    },
    {
      "id": 42161,
      "name": "Arbitrum",
      "native": "ETH"
    },
    {
      "id": 8453,
      "name": "Base",
      "native": "ETH"
    },
    {
      "id": 43114,
      "name": "Avalanche",
      "native": "AVAX"
    },
    {
      "id": 4217,
      "name": "Tempo",
      "native": "USD"
    },
    {
      "id": 4663,
      "name": "Robinhood Chain",
      "native": "ETH"
    },
    {
      "id": 9745,
      "name": "Plasma",
      "native": "XPL"
    },
    {
      "id": 250,
      "name": "Fantom",
      "native": "FTM"
    },
    {
      "id": 59144,
      "name": "Linea",
      "native": "ETH"
    },
    {
      "id": 5000,
      "name": "Mantle",
      "native": "MNT"
    },
    {
      "id": 100,
      "name": "Gnosis",
      "native": "xDAI"
    },
    {
      "id": 534352,
      "name": "Scroll",
      "native": "ETH"
    },
    {
      "id": "solana",
      "name": "Solana",
      "native": "SOL"
    },
    {
      "id": "sui",
      "name": "Sui",
      "native": "SUI"
    },
    {
      "id": "ton",
      "name": "TON",
      "native": "TON"
    }
  ]
}
