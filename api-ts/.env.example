# Suwappu TypeScript API — example environment.
#
#   cp .env.example .env
#
# Every variable here is optional in development; the service boots with defaults.
# In production, four are enforced at startup: DATABASE_URL, TELEGRAM_BOT_TOKEN,
# JWT_SECRET and ADMIN_API_KEY.
#
# Full schema and defaults: src/config/EnvService.ts

NODE_ENV=development
PORT=8000

# Shared with the Python service. See ../docs/development/migrations.md for the
# table-ownership rules before changing any schema.
DATABASE_URL=

# Same token the Python bot uses — required to validate Telegram Mini App auth.
TELEGRAM_BOT_TOKEN=

# Generate:  openssl rand -base64 32
JWT_SECRET=

# Protects the /admin/* routes.
ADMIN_API_KEY=

# Protects /internal/* service-to-service routes, and authenticates calls to the
# Python API at INTERNAL_API_URL.
INTERNAL_API_KEY=
INTERNAL_API_URL=http://localhost:8000

# Comma-separated. Defaults already include localhost:3000 and localhost:5173.
ALLOWED_ORIGINS=

# Optional — caching and rate limiting fall back to in-memory when unset.
REDIS_URL=

# Optional error tracking. Unset = no-op, no init, no added latency.
SENTRY_DSN=

# ─── Turnkey (TEE-backed wallets) ────────────────────────────────────────────
# Only needed when running with the Turnkey wallet provider.
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_ORGANIZATION_ID=
