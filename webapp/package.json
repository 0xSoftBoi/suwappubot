{
  "name": "suwappu-webapp",
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "bun test src/hooks src/lib src/components --preload ./src/test/happy-dom-setup.ts",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "bun test src/test/integration",
    "test:all": "bun run test && bun run test:integration"
  },
  "dependencies": {
    "@suwappu/design-tokens": "file:../packages/design-tokens",
    "@tanstack/react-query": "^5.101.0",
    "@turnkey/sdk-browser": "^5.14.2",
    "@turnkey/viem": "^0.14.31",
    "@twa-dev/sdk": "^7.10.0",
    "framer-motion": "^12.40.0",
    "lightweight-charts": "^5.2.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "6.28.2",
    "viem": "^2.53.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-onboarding": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.0.17",
    "autoprefixer": "^10.5.0",
    "happy-dom": "^20.10.6",
    "jsdom": "^27.4.0",
    "playwright": "^1.61.0",
    "postcss": "^8.5.15",
    "storybook": "^10.1.11",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
