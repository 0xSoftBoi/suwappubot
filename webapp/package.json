{
  "name": "suwappu-webapp",
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "bun test src/hooks src/lib src/components --preload ./src/test/happy-dom-setup.ts",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "bun test src/test/integration",
    "test:all": "bun run test && bun run test:integration"
  },
  "dependencies": {
    "@p2pdotme/sdk": "^1.2.16",
    "@suwappu/design-tokens": "file:../packages/design-tokens",
    "@tanstack/react-query": "^5.101.4",
    "@turnkey/sdk-browser": "^5.15.1",
    "@turnkey/viem": "^0.14.36",
    "@twa-dev/sdk": "^7.10.0",
    "framer-motion": "^12.43.0",
    "i18next": "^26.3.6",
    "lightweight-charts": "^5.2.1",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "viem": "^2.55.18"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/addon-onboarding": "^10.5.9",
    "@storybook/addon-vitest": "^10.5.9",
    "@storybook/react-vite": "^10.5.9",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.9",
    "happy-dom": "^20.11.2",
    "jsdom": "^29.0.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "storybook": "^10.1.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "viem": "$viem"
  }
}
