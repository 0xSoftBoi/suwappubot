.DS_Store

# Secrets — never commit real credentials.
# All .env files are ignored; the checked-in templates/public files are re-included below.
.env
.env.*
!.env.example
!.env.template
!.env.prod.template
!.env.testnet
!**/.env.example
!**/.env.development
*.pem
*.p12
*.key
id_rsa*
credentials.json
serviceaccount*.json

# Python cache/build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# JavaScript package/build artifacts
node_modules/
**/node_modules/
*.tsbuildinfo
packages/*/dist/

# Frontend generated artifacts
showcase/.next/
showcase/out/
showcase/qa-screenshots/
terminal/qa-screenshots/
terminal/storybook-static/
webapp/dist/

# extension
extension/dist/
extension/node_modules/

# local dev venv
.venv/

# Local testnet deployer key (never commit)
scripts/.deployer_key
scripts/deployed_addresses.json

# crypto sec-tool artifacts
contracts/crytic-export/
contracts/slither_results.json
