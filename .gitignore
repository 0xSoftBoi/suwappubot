.DS_Store

# Local security-audit working directory (exploit paths, preconditions) —
# never push exact exploitation steps for findings that may still be open.
.audit/

# Python cache/build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# JavaScript package/build artifacts
node_modules/
**/node_modules/
*.tsbuildinfo
packages/*/dist/

# Frontend generated artifacts
showcase/.next/
showcase/out/
showcase/qa-screenshots/
terminal/qa-screenshots/
terminal/storybook-static/
webapp/dist/

# extension
extension/dist/
extension/node_modules/

# local dev venv
.venv/

# Local testnet deployer key (never commit)
scripts/.deployer_key
scripts/deployed_addresses.json

# crypto sec-tool artifacts
contracts/crytic-export/
contracts/slither_results.json
.venv-test/
.claude/settings.local.json
contracts/lib/openzeppelin-contracts/package-lock.json

# Local environment files (secrets). Nothing matching these may ever be
# committed; .env.example / .env.sample are the documented, key-free templates.
.env
.env.*
!.env.example
!.env.sample

# AEGIS runtime state/telemetry (bot/services/aegis_service.py)
.aegis/
