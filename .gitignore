.DS_Store

# Python cache/build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# JavaScript package/build artifacts
node_modules/
**/node_modules/
*.tsbuildinfo
packages/*/dist/

# Frontend generated artifacts
showcase/.next/
showcase/out/
showcase/qa-screenshots/
terminal/qa-screenshots/
terminal/storybook-static/
webapp/dist/

# extension
extension/dist/
extension/node_modules/

# local dev venv
.venv/

# Local testnet deployer key (never commit)
scripts/.deployer_key
scripts/deployed_addresses.json

# crypto sec-tool artifacts
contracts/crytic-export/
contracts/slither_results.json
.venv-test/
.claude/settings.local.json
contracts/lib/openzeppelin-contracts/package-lock.json
.coverage
.deepsec/
