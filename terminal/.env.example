# Suwappu Terminal — environment template. Copy to .env.local for local dev.
# All vars are Vite build-time vars (VITE_*), baked into the bundle at build.

# Base URL of the API the terminal talks to.
#   Local:  http://localhost:8000
#   Prod:   https://api.suwappu.bot
VITE_API_URL=http://localhost:8000

# Helius API key — powers the live Solana discovery feed / wallet inspector.
# Get one at https://helius.dev. Optional for non-Solana flows.
VITE_HELIUS_API_KEY=

# WalletConnect / Reown project id. REQUIRED for WalletConnect and for the Ledger
# hardware-wallet fallback (Ledger Live over WalletConnect). Get one at
# https://cloud.reown.com (formerly WalletConnect Cloud).
#   - Dev: if unset, the terminal falls back to 'demo' (software wallets + the
#     Ledger browser Extension still work; Ledger Live pairing does not).
#   - Prod: if unset, the terminal uses a 'missing-see-docs' sentinel so the
#     misconfiguration fails loudly instead of silently. Set this on Railway as a
#     build arg/secret before deploying. See docs/integrations/ledger-wallet.md.
VITE_WC_PROJECT_ID=
