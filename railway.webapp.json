{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "webapp/Dockerfile",
    "watchPatterns": [
      "/webapp/**",
      "/packages/design-tokens/**",
      "/railway.webapp.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "numReplicas": 1,
    "overlapSeconds": 30,
    "drainingSeconds": 30
  }
}
